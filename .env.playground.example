# Copy to .env ON THE HOSTING and fill in the credentials there.
APP_NAME=Illuna
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://playground.illunaai.de
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=10.35.232.152
DB_PORT=3306
DB_DATABASE=k192180_playground_illuna
DB_USERNAME=REPLACE_ON_SERVER
DB_PASSWORD=REPLACE_ON_SERVER

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_COOKIE=illuna_playground_session
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Configure SMTP before testing registration, verification and password reset.
# Port 587: smtp (STARTTLS required by config); port 465: smtps.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=REPLACE_ON_SERVER
MAIL_PORT=587
MAIL_USERNAME=REPLACE_ON_SERVER
MAIL_PASSWORD=REPLACE_ON_SERVER
MAIL_FROM_ADDRESS=REPLACE_ON_SERVER
MAIL_FROM_NAME="${APP_NAME}"

# Enable after SMTP is configured. Existing accounts can still sign in.
ILLUNA_REGISTRATION_ENABLED=false
ILLUNA_NOINDEX=true

# Set the full HTTPS workflow URL on the server for the account-only REST example.
# Keep real endpoints out of source control. Public examples always use a placeholder.
ILLUNA_API_URL=
